{
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD007": { "indent": 2 },
    "MD013": { "line_length": 120 },
    "MD033": false,
    "MD041": false
  },
  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    "AGENT_REPORT_*.md",
    "*-review-report.md",
    "CODE_QUALITY_REPORT.md",
    "DOCUMENTATION_REVIEW.md",
    "matrix.md",
    "tracematrix.md"
  ]
}
